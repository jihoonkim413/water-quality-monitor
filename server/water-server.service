[Unit]
Description=Water quality server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/water_quality/server
Environment=WATER_API_KEY=change-me
Environment=WATER_DB=/home/pi/water_quality/server/water.db
ExecStart=/home/pi/water_quality/server/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
